{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PageTurn (Tauri)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS": "--remote-debugging-port=9222"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to the PageTurn window (WebView2)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Debug All",
      "configurations": ["Debug PageTurn (Tauri)", "Attach to the PageTurn window (WebView2)"],
      "presentation": { "order": 1 }
    }
  ]
}

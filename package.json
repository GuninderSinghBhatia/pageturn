{
  "name": "pageturn",
  "version": "2.1.0",
  "description": "PageTurn - a PDF reader that reads like a real book",
  "author": "PageTurn",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "tauri dev",
    "build": "npm run typecheck && tauri build",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e": "npm run tauri:build:debug && playwright test",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "release": "node scripts/release-tauri.mjs",
    "tauri:vite": "vite --config vite.tauri.config.ts",
    "tauri:vite:build": "vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "cd src-tauri && cargo build --no-default-features",
    "tauri:test": "playwright test -c playwright.tauri.config.ts",
    "tauri:test:installers:build": "node scripts/build-test-installers.mjs",
    "tauri:test:installers": "playwright test -c playwright.installer.config.ts",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "perfect-freehand": "^1.2.3",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  }
}

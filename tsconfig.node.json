{
  "extends": "./tsconfig.base.json",
  "include": [
    "vitest.config.*",
    "playwright*.config.*",
    "vite.tauri.config.*",
    "src/shared/**/*",
    "src/renderer/api.d.ts",
    "scripts/**/*",
    "tests/e2e/**/*",
    "tests/tauri/**/*",
    "tests/installer/**/*",
    "tests/measure/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
